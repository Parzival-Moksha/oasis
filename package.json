{
  "name": "oasis",
  "version": "1.0.0",
  "private": true,
  "description": "The Oasis — 3D world builder with AI text-to-3D conjuring",
  "scripts": {
    "dev": "next dev -p 4516",
    "dev:docs": "pnpm docs:local && pnpm dev",
    "dev:loop": "node scripts/dev-loop.js",
    "dev:agent": "node scripts/dev-agent.js",
    "dev:relay": "node scripts/openclaw-relay-dev.mjs",
    "dev:room": "pnpm --dir packages/oasis-room-server dev",
    "docs:local": "node scripts/sync-local-docs.mjs",
    "build": "next build",
    "start": "next start -p 4516",
    "smoke:relay-hosted": "node scripts/openclaw-relay-hosted-smoke.mjs",
    "deploy:openclaw": "node scripts/deploy-openclaw-parzival.mjs",
    "seed:default-worlds": "npx tsx prisma/seed-default-worlds.ts",
    "seed:welcome-hub": "npx tsx prisma/seed-default-worlds.ts --world=portal-zero --update-core --snapshot",
    "world:export-default": "npx tsx prisma/export-default-world.ts",
    "audit:catalog-placements": "node scripts/audit-catalog-placements.mjs",
    "lint": "eslint src scripts next.config.mjs postcss.config.js tailwind.config.js vitest.config.ts --ext .js,.mjs,.ts,.tsx --report-unused-disable-directives"
  },
  "dependencies": {
    "@a2ui/web_core": "0.9.2",
    "@google/genai": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pixiv/three-vrm": "^3.5.0",
    "@prisma/client": "^6.19.2",
    "@react-three/drei": "^9.99.0",
    "@react-three/fiber": "^8.15.0",
    "@react-three/postprocessing": "^2.16.0",
    "@zumer/snapdom": "^2.6.0",
    "colyseus.js": "^0.16.0",
    "ffmpeg-static": "^5.3.0",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.30",
    "prisma": "^6.19.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "simplex-noise": "^4.0.3",
    "stripe": "^20.4.0",
    "three": "^0.162.0",
    "wlipsync": "^1.3.0",
    "zod": "^4.3.6",
    "zustand": "^4.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "ffmpeg-static",
      "prisma",
      "sharp"
    ]
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.162.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "8.58.2",
    "@typescript-eslint/parser": "8.58.2",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.58.2",
    "pm2": "6.0.14",
    "postcss": "^8.4.49",
    "postprocessing": "^6.38.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0",
    "ws": "^8.20.0"
  }
}
