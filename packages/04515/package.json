{
  "name": "@04515xyz/oasis-bridge",
  "version": "0.1.15",
  "type": "module",
  "description": "Connect OpenClaw or Hermes to the hosted Oasis at openclaw.04515.xyz.",
  "license": "MIT-0",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "oasis-bridge": "bin/04515-bridge.mjs",
    "04515-bridge": "bin/04515-bridge.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    "cli.mjs",
    "index.mjs",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./index.mjs"
    ],
    "build": {
      "openclawVersion": "2026.5.2",
      "pluginSdkVersion": "2026.5.2"
    },
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.4.15"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.20.0"
  },
  "peerDependencies": {
    "openclaw": "2026.4.15"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  }
}
