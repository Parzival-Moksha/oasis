# The Oasis writes a .env like this one on its first start. Everything below is optional.
DATABASE_URL="file:./data/oasis.db"
NEXT_PUBLIC_OASIS_PROFILE=village
OASIS_EDITION=slim

# Ports (defaults: the page 4516, the agent engine 4530)
# OASIS_WEB_PORT=4516
# OASIS_PORT=4530

# A spoken voice from ElevenLabs, with your own key. Without it agents speak with your browser's built-in voices.
# ELEVENLABS_API_KEY=

# Voice typing with a local helper (Python 3, about 50 MB, and a speech model downloaded once). Off until you say so.
# OASIS_EARS_INSTALL=1

# Agents normally run on your Claude subscription. To let them use ANTHROPIC_API_KEY from your environment instead:
# OASIS_KEEP_API_KEY=1
