# ═══════════════════════════════════════════════════════════════
# OASIS — Environment Variables
# Copy this to .env and fill in your API keys
# ═══════════════════════════════════════════════════════════════

# Database (SQLite — works out of the box, no setup needed)
DATABASE_URL="file:./data/oasis.db"

# Text-to-3D Providers (optional — conjure tab won't work without these)
MESHY_API_KEY=
TRIPO_API_KEY=

# LLM Procedural Geometry (optional — craft/terrain tools)
OPENROUTER_API_KEY=

# Gemini Live lab (optional - server-side config/session manifest only for now)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Image Generation (optional)
FAL_KEY=

# Voice Generation (optional)
ELEVENLABS_API_KEY=

# Agent village (optional, local only). Per tab: open http://localhost:4516/?profile=village
# (?profile=local turns it off again). Always on: uncomment, then restart `pnpm dev`.
# Agents come from the engine: run `pnpm dev:engine` next to `pnpm dev`.
# NEXT_PUBLIC_OASIS_PROFILE=village
# NEXT_PUBLIC_AGENT_ENGINE_URL=ws://127.0.0.1:4530/ws
# NEXT_PUBLIC_ANORAK_PRO_CWD=C:\7c_oasis
